{
  "name": "deepseek-harness-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render-ready wrapper: runs DeepSeek Harness (dsh) web UI non-interactively behind a 0.0.0.0 reverse proxy.",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "postinstall": "node scripts/patch-settings-loopback.mjs",
    "start": "node proxy.js",
    "build": "node -e \"import('@deepseek-ai/dsh').then(()=>console.log('deps ok')).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "http-proxy": "^1.18.1"
  }
}
